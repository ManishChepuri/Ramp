# Runtime curriculum provider (watsonx is independent of Bobcoins)
RAMP_GENERATION_PROVIDER=watsonx

# IBM watsonx.ai credentials used by `ramp generate`
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Optional watsonx tuning
WATSONX_CONCURRENCY=3
WATSONX_MAX_RETRIES=2
WATSONX_TIMEOUT_MS=120000

# Optional legacy Bob Shell provider (set RAMP_GENERATION_PROVIDER=bob)
BOB_API_KEY=

# Required only when BOB_API_KEY is a general key rather than an inference key
BOB_TEAM_ID=

# Optional generation limits
BOB_MAX_COST=
BOB_MAX_TURNS=

# Local Ramp server
RAMP_SERVER_PORT=3001
