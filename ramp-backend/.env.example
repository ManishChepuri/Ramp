# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# IBM watsonx.ai
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloudant
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your_cloudant_api_key_here
CLOUDANT_DB_PROGRESS=ramp-progress
CLOUDANT_DB_MANIFESTS=ramp-manifests

# IBM Speech-to-Text
STT_APIKEY=your_stt_api_key_here
STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# Server
PORT=3001
FRONTEND_DIST=../ramp-frontend/dist
MANIFEST_PATH=../fixtures/sample-manifest.json
